#!/usr/bin/env bash
# bestest — thin wrapper around scripts/bestest-cli.py
# Resolves its own location so it works from any agent host regardless of cwd.
# Usage: bestest <subcommand> [args...]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI="$SCRIPT_DIR/bestest-cli.py"

if ! command -v python3 >/dev/null 2>&1; then
  echo "bestest: python3 is required but was not found on PATH." >&2
  echo "bestest: falling back to manual instructions in the spoke files (graceful degradation)." >&2
  exit 2
fi

exec python3 "$CLI" "$@"
